# Supabase (Project Settings → API)
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=your_anon_key

# The only admin account
VITE_ADMIN_EMAIL=you@studio.com

# Cloudinary unsigned folder uploads
VITE_CLOUDINARY_CLOUD_NAME=your_cloud_name
VITE_CLOUDINARY_UPLOAD_PRESET=your_unsigned_upload_preset
VITE_CLOUDINARY_FOLDER=users

# Puter auth token from puter.com/dashboard → Account → Create token
PUTER_API_KEY=your_puter_api_key
